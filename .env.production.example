# ==============================================================================
# Locelio — Production Environment Configuration Template
# COPY TO .env.production AND FILL WITH REAL VALUES BEFORE DEPLOYMENT
# DO NOT COMMIT THE ACTUAL .env.production FILE
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION A: OBLIGATOIRE AU DÉMARRAGE (Bootstrapping)
# ------------------------------------------------------------------------------

# PostgreSQL Credentials for the dedicated Locelio container
POSTGRES_USER="locelio_admin"
POSTGRES_PASSWORD="GENERATE_A_SECURE_RANDOM_PASSWORD_32_CHARS"
POSTGRES_DB="locelio_production"

# Application URLs & Ports
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
NEXT_PUBLIC_SITE_URL="https://locelio.fr"
NEXT_PUBLIC_APP_URL="https://locelio.fr"

# Better Auth Authentication Secret (32+ chars random string)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="GENERATE_A_STRONG_RANDOM_BETTER_AUTH_SECRET"
BETTER_AUTH_URL="https://locelio.fr"

# ------------------------------------------------------------------------------
# SECTION B: OBLIGATOIRE AVANT OUVERTURE PUBLIQUE (Billing, Emails, Cron)
# ------------------------------------------------------------------------------

# Stripe Live Keys & Webhook
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Subscription Price IDs (Production Live Mode)
# Create in Stripe Dashboard > Products
STRIPE_STARTER_MONTHLY_PRICE_ID="price_..."
STRIPE_STARTER_ANNUAL_PRICE_ID="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_ANNUAL_PRICE_ID="price_..."

# Resend Transactional Email API (Production Domain locelio.fr)
RESEND_API_KEY="re_..."
RESEND_DOMAIN="locelio.fr"

# Cron Secret for automated maintenance endpoints (/api/cron/*)
# Generate with: openssl rand -hex 16
CRON_SECRET="GENERATE_A_STRONG_CRON_SECRET_16_CHARS"

# ------------------------------------------------------------------------------
# SECTION C: OPTIONNELLES / SERVICES AVANCÉS
# ------------------------------------------------------------------------------

# Upstash Redis (For distributed rate limiting across multiple instances)
# If empty, the application safely falls back to local memory rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Document Storage (MinIO or S3 for external receipts/leases archives)
# If empty, documents are stored via database inline storage / local filesystem
MINIO_ENDPOINT=""
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="locelio-documents"

# DSP2 Open Banking (Bridge / Powens for automated bank synchronization)
BANK_WEBHOOK_SECRET=""
# BRIDGE_CLIENT_ID=""
# BRIDGE_CLIENT_SECRET=""

# Monitoring & Error Tracking (Sentry / PostHog)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# Diagnostics & Performance logs
SLOW_QUERY_LOG="false"
SLOW_QUERY_THRESHOLD_MS="500"
