# ─── Database ───
DATABASE_URL="postgresql://user:password@localhost:5432/rentready?schema=public"

# ─── OpenAI (for Vercel AI SDK) ───
OPENAI_API_KEY="sk-..."

# ─── Stripe ───
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# ─── Open Banking (Bridge API / Powens) — DSP2 ───
BANK_WEBHOOK_SECRET="your-bank-webhook-secret"
# BRIDGE_CLIENT_ID="..."
# BRIDGE_CLIENT_SECRET="..."

# ─── Cron ───
# Bearer token guarding /api/cron/*. Vercel sends this automatically as
# "Authorization: Bearer <CRON_SECRET>" when it invokes a cron in vercel.json.
# Random string, 16+ chars. Without it the cron routes answer 500 rather than
# running unauthenticated.
# CRON_SECRET="change-me-16-chars-min"

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional. Only set this if authentication is served from a different origin than
# the app itself. When unset, the auth client uses the origin the page is served
# from, which is correct in almost every case. Hardcoding an origin here previously
# meant sign-in was posted to the wrong host whenever the app ran on another port.
# NEXT_PUBLIC_AUTH_URL="https://app.rent-ready.fr"
