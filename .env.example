# ─── Database ───
DATABASE_URL="postgresql://user:password@localhost:5432/rentready?schema=public"

# ─── OpenAI (for Vercel AI SDK) ───
OPENAI_API_KEY="sk-..."

# ─── Stripe ───
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# Subscription plans. Each plan needs its OWN Stripe Price: the checkout charges
# from this id, so a single id for two plans means the landlord is charged the
# price of whichever plan it points at, not the one they clicked. With Starter
# missing, "9 €/mois" created a Pro checkout at 15 €/mois.
STRIPE_STARTER_MONTHLY_PRICE_ID="price_..."
STRIPE_STARTER_ANNUAL_PRICE_ID="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_ANNUAL_PRICE_ID="price_..."

# ─── Open Banking (Bridge API / Powens) — DSP2 ───
BANK_WEBHOOK_SECRET="your-bank-webhook-secret"
# BRIDGE_CLIENT_ID="..."
# BRIDGE_CLIENT_SECRET="..."

# ─── Cron ───
# Bearer token guarding /api/cron/*. Vercel sends this automatically as
# "Authorization: Bearer <CRON_SECRET>" when it invokes a cron in vercel.json.
# Random string, 16+ chars. Without it the cron routes answer 500 rather than
# running unauthenticated.
# CRON_SECRET="change-me-16-chars-min"

# ─── App ───
# Canonical origin for SEO: canonical URLs, schema `url`, robots.txt and every
# sitemap entry. Deliberately NOT NEXT_PUBLIC_APP_URL, which answers "where is this
# deployment running" and is therefore the preview URL on a branch — a sitemap of
# preview hostnames invites the wrong pages to be indexed under the wrong address.
# Change it in ONE place when the domain is chosen; the code has no other copy.
# Defaults to https://www.rentready.fr when unset.
NEXT_PUBLIC_SITE_URL="https://www.rentready.fr"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional. Only set this if authentication is served from a different origin than
# the app itself. When unset, the auth client uses the origin the page is served
# from, which is correct in almost every case. Hardcoding an origin here previously
# meant sign-in was posted to the wrong host whenever the app ran on another port.
# NEXT_PUBLIC_AUTH_URL="https://app.rent-ready.fr"
