# ========================================
# Docker Ignore for Lokna Production
# ========================================

# Version control
.git
.gitignore

# Environment variables — CRITICAL: never bake into image!
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.production.example

# Local build output and cache
.next
.next-dev
out
dist
build

# Dependencies
node_modules
.pnpm-store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test files, coverage and reports
coverage
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
playwright-report
test-results
blob-report
playwright/.cache

# Editor & AI agents caches
.idea
.vscode
*.swp
*.swo
.DS_Store
.gemini
.claude
.codex
.system_generated

# Temporary and scratch directories
tmp
temp
scratch
